{
  "type": "SCREEN",
  "note": "Menu des warps (plugin KoriaWarps). Données : %var_warps_*%, list:warps_liste (id, nom, icone, statut, infobulle, resume, monde, prix).",
  "width": 320,
  "height": 200,
  "anchor": "CENTER",
  "scaleMode": "ADAPT",
  "referenceWidth": 480,
  "referenceHeight": 270,
  "background": "#A0000000",
  "blur": true,
  "closeOnEscape": true,
  "openSound": "random.pop",
  "closeSound": "",
  "openAnimation": "ZOOM",
  "animationDuration": 200,
  "refreshTicks": 20,
  "elements": [
    {
      "type": "RECT",
      "id": "fond",
      "x": 0,
      "y": 0,
      "width": 320,
      "height": 200,
      "color": "#E60E141C",
      "radius": 8,
      "borderColor": "#FF3E7CB1",
      "borderWidth": 1
    },
    {
      "type": "RECT",
      "id": "bandeau",
      "x": 0,
      "y": 0,
      "width": 320,
      "height": 26,
      "color": "#FF14222E",
      "gradient": "#FF0E141C",
      "radius": 8
    },
    {
      "type": "ITEM",
      "id": "bandeau_icone",
      "x": 8,
      "y": 5,
      "width": 16,
      "height": 16,
      "item": "minecraft:compass"
    },
    {
      "type": "TEXT",
      "id": "titre",
      "x": 0,
      "y": 5,
      "width": 320,
      "height": 12,
      "align": "CENTER",
      "text": "&b&lWarps",
      "scale": 1.25
    },
    {
      "type": "TEXT",
      "id": "compteur",
      "x": 0,
      "y": 17,
      "width": 312,
      "height": 8,
      "align": "RIGHT",
      "scale": 0.65,
      "text": "&7%var_warps_accessibles%&8/&7%var_warps_total% accessibles"
    },
    {
      "type": "REPEATER",
      "id": "liste",
      "x": 12,
      "y": 32,
      "width": 300,
      "height": 136,
      "source": "list:warps_liste",
      "itemWidth": 70,
      "itemHeight": 58,
      "spacing": 5,
      "direction": "GRID",
      "columns": 4,
      "scroll": "VERTICAL",
      "clip": true,
      "emptyText": "&7Aucun warp pour le moment.",
      "children": [
        {
          "type": "RECT",
          "id": "carte",
          "x": 0,
          "y": 0,
          "width": 70,
          "height": 58,
          "color": "#C0182430",
          "borderColor": "#FF2E4A60",
          "borderWidth": 1,
          "radius": 5,
          "condition": "\"{item.statut}\" == \"libre\"",
          "tooltip": "{item.infobulle}",
          "hoverColor": "#E0243A4C",
          "actions": [
            "close",
            "command: %var_warps_commande% {item.id}"
          ],
          "clickSound": true
        },
        {
          "type": "RECT",
          "id": "carte_verrouillee",
          "x": 0,
          "y": 0,
          "width": 70,
          "height": 58,
          "color": "#C0141414",
          "borderColor": "#FF3A3A3A",
          "borderWidth": 1,
          "radius": 5,
          "condition": "\"{item.statut}\" == \"verrouille\"",
          "tooltip": "{item.infobulle}",
          "hoverColor": "#40FFFFFF"
        },
        {
          "type": "ITEM",
          "id": "icone",
          "x": 23,
          "y": 6,
          "width": 24,
          "height": 24,
          "item": "{item.icone}"
        },
        {
          "type": "ITEM",
          "id": "cadenas",
          "x": 54,
          "y": 3,
          "width": 12,
          "height": 12,
          "item": "minecraft:barrier",
          "condition": "\"{item.statut}\" == \"verrouille\""
        },
        {
          "type": "TEXT",
          "id": "nom",
          "x": 2,
          "y": 34,
          "width": 66,
          "height": 10,
          "align": "CENTER",
          "scale": 0.8,
          "text": "{item.nom}"
        },
        {
          "type": "TEXT",
          "id": "prix",
          "x": 2,
          "y": 46,
          "width": 66,
          "height": 8,
          "align": "CENTER",
          "scale": 0.6,
          "text": "{item.prix}",
          "condition": "\"{item.statut}\" == \"libre\""
        },
        {
          "type": "TEXT",
          "id": "verrou",
          "x": 2,
          "y": 46,
          "width": 66,
          "height": 8,
          "align": "CENTER",
          "scale": 0.6,
          "text": "&cVerrouillé",
          "condition": "\"{item.statut}\" == \"verrouille\""
        }
      ]
    },
    {
      "type": "BUTTON",
      "id": "spawn",
      "x": 12,
      "y": 174,
      "width": 146,
      "height": 20,
      "text": "&6Spawn",
      "actions": [
        "close",
        "command: %var_warps_commande_spawn%"
      ],
      "icon": "minecraft:bed",
      "condition": "%var_warps_spawn% == true",
      "color": "#C0182430",
      "hoverColor": "#E0243A4C",
      "borderColor": "#FF2E4A60",
      "hoverBorderColor": "#FF4FA8E0",
      "borderWidth": 1,
      "radius": 4,
      "hoverScale": 1.03,
      "clickSound": true
    },
    {
      "type": "BUTTON",
      "id": "fermer",
      "x": 166,
      "y": 174,
      "width": 146,
      "height": 20,
      "text": "&cFermer",
      "actions": [
        "close"
      ],
      "color": "#C0182430",
      "hoverColor": "#E0243A4C",
      "borderColor": "#FF2E4A60",
      "hoverBorderColor": "#FF4FA8E0",
      "borderWidth": 1,
      "radius": 4,
      "hoverScale": 1.03,
      "clickSound": true
    }
  ]
}
